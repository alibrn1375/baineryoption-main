# Environment Variables Template for FO-X 5M Production Deployment
# Copy this file to .env and populate with production credentials.

# --- Environment & Server ---
ENVIRONMENT=production
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SECRET_KEY=change-this-to-a-secure-random-64-char-string-in-production
API_RATE_LIMIT=120

# --- Database Credentials (PostgreSQL) ---
DB_ENGINE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fox_trading
DB_USER=fox_admin
DB_PASSWORD=your_secure_db_password_here

# --- Market Data Feed Credentials ---
DATA_PROVIDER_TYPE=ninjatrader
NINJATRADER_HOST=127.0.0.1
NINJATRADER_PORT=8088
WEBSOCKET_FEED_URI=wss://stream.marketdata.local/v1/ticks
WEBSOCKET_API_KEY=your_feed_api_key_here

# --- Storage & Backup Directories ---
STORAGE_RESEARCH_PATH=data/research
STORAGE_BACKUP_PATH=data/backups
LOG_PATH=logs

# --- Monitoring & Alerts ---
ALERT_WEBHOOK_URL=
SENTRY_DSN=
