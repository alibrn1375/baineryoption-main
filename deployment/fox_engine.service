[Unit]
Description=FO-X 5M Quantitative Engine Background Service
After=network.target postgresql.service

[Service]
Type=simple
User=fox
WorkingDirectory=/opt/fox_trading
ExecStart=/opt/fox_trading/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 4
Restart=always
RestartSec=5s
EnvironmentFile=/opt/fox_trading/.env
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
